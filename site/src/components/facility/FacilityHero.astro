---
const { view } = Astro.props;
---
<div class="wrap hero">
  <div class="eyebrow">Evidence dossier · dataset exported {view.asOf}</div>
  <div class="statusline"><span class="status">{view.statusLabel}</span>{view.flags?.length ? view.flags.map((flag: string) => <span class="risk">{flag.replaceAll("_", " ")}</span>) : <span class="quiet">No published risk flags</span>}</div>
  <h1>{view.name}</h1><p class="location">{view.location} · {view.developer || "Under verification"} → {view.offtaker || "Under verification"}</p>
  {view.recordReview && <div class="notice" id="record-review"><b>Primary-record review · {view.recordReview.date}</b><p>{view.recordReview.text}</p><a href={view.recordReview.url} target="_blank" rel="noopener">Reviewed source ↗</a></div>}
  <p class="intro">The capacity below describes a documented equipment cohort. Current delivered power, complete installed capacity and present operation of every unit are not established by this total.</p>
  <div class="hero-grid">
    <div class="capacity"><div><span class="number">{view.capacityMw}</span> <span class="unit">MW documented equipment capacity</span></div><p>{view.capacityNote}</p></div>
    <aside class="signal"><div class="eyebrow">Satellite evidence</div><h2>{view.satellite.date}</h2><p>{view.satellite.text}</p><p class="eyebrow" style="margin-top:12px">{view.satellite.coords}</p><a href={view.satellite.url} target="_blank" rel="noopener">{view.satellite.label}</a></aside>
  </div>
</div>
