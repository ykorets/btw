---
import { capacity, equipmentLabel, monthsToPower } from "../../lib/facts";
const facilities = Astro.props.facilities.map((f: any) => ({ ...f, documentedMw: capacity(f).mw,
  equipmentText: (f.unit || []).map(equipmentLabel).join(" + "), reviewedMonths: monthsToPower(f) }));
---
<script is:inline src="https://cdn.jsdelivr.net/npm/d3@7"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/topojson-client@3"></script>
<script is:inline define:vars={{ facilities }}>
const FAC=Promise.resolve({facilities});
const esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const GENRE={tceq_standard_permit_review:"TCEQ permit",permit:"MDEQ permit",appeal_filing:"Permit appeal",court_filing:"Court filing",satellite_scene:"Satellite",advocacy_letter:"SELC letter"};
const col={op:"#157a54"};
const svg=d3.select("#usmap");
const path=d3.geoPath(d3.geoAlbersUsa().scale(1280).translate([487,305]));
Promise.all([d3.json("https://cdn.jsdelivr.net/npm/us-atlas@3/states-10m.json"),FAC]).then(([us,d])=>{
  svg.selectAll("path").data(topojson.feature(us,us.objects.states).features).join("path")
    .attr("d",path).attr("fill","#f1f0ea").attr("stroke","#dedcd2").attr("stroke-width",.7);
  const proj=d3.geoAlbersUsa().scale(1280).translate([487,305]);
  const r=d3.scaleSqrt([100,8000],[5,26]);
  const ops=(d.facilities||[]).flatMap(f=>{
    const m=/\((-?[0-9.]+),(-?[0-9.]+)\)/.exec(f.geo||"");
    if(!m||f.status!=="operating")return[];
    const mw=f.documentedMw;
    if(mw==null)return[];
    return[{n:f.name,c:[+m[1],+m[2]],mw,s:"op",v:1,f}];
  });
  const stageLbl={op:"Operating"};
  const stageTag={op:"tag-green"};
  const info=document.getElementById("map-info");
  function showInfo(d){
    let h='<div class="mi-h"><b>'+esc(d.n)+'</b><span class="tag '+stageTag[d.s]+'">'+stageLbl[d.s]+'</span><span class="mi-mw">'+d.mw.toLocaleString()+' MW documented'+'</span></div>';
    if(d.v&&d.f){
      const f=d.f, units=f.equipmentText;
      h+='<div style="margin-top:4px">'+esc([f.county,f.state].filter(Boolean).join(" County, "))+
         (f.developer?' · '+esc(f.developer):'')+(f.offtaker?' → '+esc(f.offtaker):'')+'</div>';
      if(units)h+='<div>'+esc(units)+'</div>';
      if(f.reviewedMonths!=null){
        const mo=f.reviewedMonths;
        h+='<div>Permit → power: '+(mo<0?"−":"")+Math.abs(mo)+' mo</div>';
      }
      const srcs=f.sources||[];
      if(srcs.length)h+='<div class="mi-src">Sources: '+srcs.map(s=>'<a href="'+esc(s.url)+'" target="_blank" rel="noopener">'+esc(GENRE[s.doc_genre]||s.doc_genre||"document")+'</a>').join(" · ")+'</div>';
    }
    info.innerHTML=h;
  }
  const circles=svg.selectAll("circle").data(ops).join("circle")
    .attr("cx",d=>proj(d.c)[0]).attr("cy",d=>proj(d.c)[1])
    .attr("r",d=>Math.max(r(d.mw),12)).attr("fill",d=>col[d.s]).attr("fill-opacity",.9)
    .attr("stroke","#fff").attr("stroke-width",1.2)
    .attr("tabindex",0).attr("role","button")
    .attr("aria-label",d=>d.n+" — "+d.mw.toLocaleString()+" MW documented")
    .on("click",function(_e,d){circles.classed("sel",false);d3.select(this).classed("sel",true);showInfo(d);})
    .on("keydown",function(e,d){if(e.key==="Enter"||e.key===" "){e.preventDefault();circles.classed("sel",false);d3.select(this).classed("sel",true);showInfo(d);}});
  circles.append("title").text(d=>d.n+" — "+d.mw.toLocaleString()+" MW"+" · documented equipment");
}).catch(()=>{document.getElementById("map-info").textContent="Map background unavailable. Facility records are available in the table below.";});

</script>
<script>
import { costModel } from "../../lib/facts";
const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
const ids = ["capex", "hr", "gas", "om", "cf", "grid", "mo", "rev", "margin"];
function calc() {
  const input = Object.fromEntries(ids.map(id => [id, Number($(id).value)]));
  for (const id of ids) $(id + "-out").textContent = id === "gas" ? input[id].toFixed(2) : input[id].toLocaleString("en-US");
  const result = costModel({capex: input.capex, heatRate: input.hr, gas: input.gas, om: input.om,
    capacityFactor: input.cf / 100, grid: input.grid, months: input.mo, revenue: input.rev, margin: input.margin / 100});
  const max = Math.max(result.btm, input.grid) * 1.05;
  for (const [id, value] of [["fuel", result.fuel], ["capex", result.capital], ["om", input.om], ["grid", input.grid]] as const) {
    $("seg-" + id).style.width = value / max * 100 + "%";
  }
  $("btm-total").textContent = `$${Math.round(result.btm)}/MWh (${Math.round(result.fuel)} fuel + ${Math.round(result.capital)} capex + ${input.om} O&M)`;
  $("grid-total").textContent = `$${input.grid}/MWh`;
  $("premium").textContent = `${result.premium < 0 ? "−" : "+"}$${Math.abs(result.premium).toFixed(1)}/MWh`;
  $("prem10").textContent = `$${result.premium10.toFixed(2)}M`;
  $("timeval").textContent = `$${result.contribution.toFixed(2)}M`;
  $("verdict").textContent = result.premium <= 0
    ? "The modeled generation cost is below the selected grid tariff. Reliability, fuel delivery, redundancy and other project costs still need evaluation."
    : `At these assumptions, ten years of additional power cost total $${result.premium10.toFixed(2)}M per MW. Earlier operation contributes $${result.contribution.toFixed(2)}M per MW at the selected margin. These are undiscounted scenario values, not a project return or payback calculation.`;
}
ids.forEach(id => $(id).addEventListener("input", calc));
document.querySelectorAll<HTMLButtonElement>(".preset[data-preset]").forEach(button => button.addEventListener("click", () => {
  button.dataset.preset!.split(",").map(Number).forEach((value, index) => { $(ids[index]).value = String(value); });
  calc();
}));
calc();
</script>
