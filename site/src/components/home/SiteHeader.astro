---
interface Props { backHref?: string; backLabel?: string }
const { backHref, backLabel = "Back" } = Astro.props;
---
<header class="site">
  <div class="wrap nav">
    <a class="logo mono" href="/" style="font-weight:500;font-size:15px"><span style="color:var(--ink-3)">behind</span><span style="display:inline-block;width:2px;height:16px;background:var(--ink);border-radius:1px;margin:0 7px;vertical-align:-2px"></span><span>the watt</span></a>
    {backHref ? (
      <nav class="nav-links">
        <a href={backHref}>← {backLabel}</a>
        <a href="/data/" class="btn hide-m">Take the data</a>
      </nav>
    ) : (
      <nav class="nav-links">
        <a href="/#tracker" class="hide-m">Tracker</a>
        <a href="/#announcements" class="hide-m">Announcements</a>
        <a href="/states/texas/" class="hide-m">Texas</a>
        <a href="/power-cost-calculator/" class="hide-m">Calculator</a>
        <a href="/data/" class="btn">Take the data</a>
      </nav>
    )}
  </div>
</header>

<style>
  .logo{white-space:nowrap;flex-shrink:0}
  .nav-links .btn{white-space:nowrap}
  @media(max-width:480px){
    .nav{gap:8px;padding-left:16px;padding-right:16px}
    .logo{font-size:12px!important;gap:3px}
    .nav-links{font-size:12px;gap:8px}
    .nav-links .btn{font-size:12px;padding:8px 10px}
  }
</style>
