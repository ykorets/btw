---
import { dateLabel } from "../../lib/facts";
const { events } = Astro.props;
const latest = events.filter((event: any) => event.source_url).slice(0, 8);
---
<section id="feed"><div class="wrap"><div class="kicker">Published evidence and reviews</div><h2>What changed, with the source</h2>
<p class="sub">Document events use the document date. A record review is dated when BTW checked the source and describes only the scope reviewed.</p>
<ul class="feed">{latest.map((e: any) => <li><span class="d">{dateLabel(e.date)}</span><span>{e.headline}</span><a class="doc" href={e.source_url} target="_blank" rel="noopener">{e.type.replaceAll("_", " ")} ↗</a></li>)}</ul>
</div></section>
