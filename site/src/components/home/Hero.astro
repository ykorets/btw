---
interface Props {
  announcedGw: number | null;
  announcedProjects: number;
  summary: Record<string, any>;
  facilityCount: number;
}
const { announcedGw, announcedProjects, summary, facilityCount } = Astro.props;
---
<section class="hero wrap">
  <h1 class="kicker">The open database of behind-the-meter data center power</h1>
  <div class="hero-nums">
    <div class="hero-num ghost" style="text-align:right"><div class="lbl">Reported pipeline · dated inventory</div><div class="val">{announcedGw == null ? <span>—</span> : <>~<span id="n-ann" data-target={announcedGw}>{announcedGw.toFixed(1)}</span> GW</>}</div><div class="lbl" style="margin-top:4px"><a href="#announcements" style="text-decoration:none;color:inherit;border-bottom:1px dotted var(--line-2)">{announcedProjects > 0 ? `${announcedProjects}-project EIP inventory · inspect` : "EIP inventory temporarily unavailable"}</a></div></div>
    <div style="width:2.5px;background:var(--ink);border-radius:1px;align-self:stretch"></div>
    <div class="hero-num live" style="text-align:left"><div class="lbl">Documented equipment</div><div class="val"><span id="n-op">{Number(summary.operating_gw).toFixed(2)}</span> GW</div><div class="lbl" style="margin-top:4px;color:var(--ink-3)"><a href="#tracker" style="text-decoration:none;color:inherit;border-bottom:1px dotted var(--line-2)">{facilityCount} facilities · inspect the records</a></div></div>
  </div>
  <p class="tagline">Track the power equipment, permits and dated evidence behind data centers. See what each record establishes, and what remains unknown.</p>
  <div class="trust"><span id="asof">Dataset exported {summary.as_of}.</span> <a href="#coverage">Check source coverage</a>. Equipment totals are not a live measure of generation. The pipeline and documented sample have different coverage and dates; their ratio is not a market completion rate.</div>
  <div class="badges">
    <span class="tag tag-green">Open data</span>
    <span class="tag tag-blue">CC BY 4.0</span>
    <span class="tag tag-amber">Free forever</span>
  </div>
  <div class="hero-cta">
    <a class="btn btn-primary" href="/data/">Take the data</a>
    <a class="btn" href="#subscribe">Read BTW Weekly</a>
  </div>
</section>
