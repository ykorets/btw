---
import CalculatorRuntime from "./CalculatorRuntime.astro";
import { costModel } from "../../lib/facts";
const initial = costModel({capex: 1600, heatRate: 9500, gas: 4, om: 10, capacityFactor: .9, grid: 65, months: 20, revenue: 20, margin: .2});
---
<section id="calc">
  <div class="wrap">
    <div class="kicker">The open cost model</div>
    <h2>What does a megawatt-hour really cost behind the meter?</h2>
    <p class="sub">Fuel by heat rate, capex annualized over 15 years at 10%, O&M — against your grid tariff, and against the value of connecting earlier. Use illustrative scenarios or set your own assumptions.</p>
    <div class="presets" style="margin-top:22px">
      <button class="preset" data-preset="1600,9500,4,10,90,65,20,20,20">Aeroderivative scenario</button>
      <button class="preset" data-preset="1400,10500,4.25,14,85,65,24,22,20">Mobile turbine scenario</button>
      <button class="preset" data-preset="1800,8500,3.5,9,92,68,18,18,20">Lower heat-rate scenario</button>
      <button class="preset" data-preset="1600,9500,8,10,90,65,20,20,20">High gas price</button>
      <button class="preset" data-preset="1600,9500,4,10,60,65,20,20,20">Underused island</button>
    </div>
    <div class="calc-grid">
      <div class="crow"><label for="capex">Capex, $/kW</label><output id="capex-out">1,600</output><input type="range" id="capex" min="800" max="2500" step="50" value="1600"></div>
      <div class="crow"><label for="hr">Heat rate, Btu/kWh</label><output id="hr-out">9,500</output><input type="range" id="hr" min="7500" max="11500" step="100" value="9500"></div>
      <div class="crow"><label for="gas">Gas, $/MMBtu</label><output id="gas-out">4.00</output><input type="range" id="gas" min="2" max="8" step="0.25" value="4"></div>
      <div class="crow"><label for="om">O&M, $/MWh</label><output id="om-out">10</output><input type="range" id="om" min="5" max="20" step="1" value="10"></div>
      <div class="crow"><label for="cf">Capacity factor, %</label><output id="cf-out">90</output><input type="range" id="cf" min="50" max="95" step="1" value="90"></div>
      <div class="crow"><label for="grid">Grid tariff, $/MWh</label><output id="grid-out">65</output><input type="range" id="grid" min="40" max="120" step="1" value="65"></div>
      <div class="crow"><label for="mo">Months saved vs queue</label><output id="mo-out">20</output><input type="range" id="mo" min="0" max="36" step="1" value="20"></div>
      <div class="crow"><label for="rev">Compute revenue, $M/MW·yr</label><output id="rev-out">20</output><input type="range" id="rev" min="2" max="30" step="1" value="20"></div>
      <div class="crow"><label for="margin">Incremental contribution margin, %</label><output id="margin-out">20</output><input type="range" id="margin" min="0" max="100" step="1" value="20"></div>
    </div>
    <p class="calc-src">All presets are illustrative assumptions, not measured facility economics or live market prices. The <a href="https://records.tceq.texas.gov/cs/idcplg?IdcService=TCEQ_EXTERNAL_SEARCH_GET_FILE&dID=8600163&Rendition=Web" target="_blank" rel="noopener">Abilene permit</a> provides equipment context; it does not establish every slider value. Gas and grid inputs can be checked against <a href="https://www.eia.gov/dnav/ng/hist/rngwhhdD.htm" target="_blank" rel="noopener">EIA gas data</a> and <a href="https://www.eia.gov/electricity/monthly/epm_table_grapher.php?t=epmt_5_6_a" target="_blank" rel="noopener">state industrial averages</a>. Earlier-operation value uses revenue × your incremental contribution margin. Include all costs other than the separately modeled power premium in that margin to avoid double counting. Results exclude discounting, taxes and any costs you have not included.</p>
    <div class="legend">
      <span><span class="dot" style="background:#c9971c;border-radius:3px"></span>Fuel</span>
      <span><span class="dot" style="background:#1f5fa8;border-radius:3px"></span>Capex</span>
      <span><span class="dot" style="background:#8a897f;border-radius:3px"></span>O&M</span>
      <span><span class="dot" style="background:#157a54;border-radius:3px"></span>Grid tariff</span>
    </div>
    <div class="bar-lbl"><span>Behind the meter</span><b id="btm-total" class="mono">${Math.round(initial.btm)}/MWh (38 fuel + {Math.round(initial.capital)} capex + 10 O&M)</b></div>
    <div class="cost-bar"><div id="seg-fuel" style="background:#c9971c"></div><div id="seg-capex" style="background:#1f5fa8"></div><div id="seg-om" style="background:#8a897f"></div></div>
    <div class="bar-lbl"><span>Grid</span><b id="grid-total" class="mono">$65/MWh</b></div>
    <div class="cost-bar"><div id="seg-grid" style="background:#157a54"></div></div>
    <div class="metric-row">
      <div class="metric"><div class="l">BTM premium</div><div class="v" id="premium">+${initial.premium.toFixed(1)}/MWh</div></div>
      <div class="metric"><div class="l">10-yr power premium, per MW</div><div class="v" id="prem10">${initial.premium10.toFixed(2)}M</div></div>
      <div class="metric"><div class="l">Earlier contribution, per MW</div><div class="v" id="timeval" style="color:var(--green)">${initial.contribution.toFixed(2)}M</div></div>
    </div>
    <div id="verdict" aria-live="polite">Default illustrative assumptions: ${initial.btm.toFixed(1)}/MWh generation cost. Adjust the inputs to compare your scenario.</div>
    <p class="scenario-link"><a id="scenario-link" href="/power-cost-calculator/#calc">Link to this scenario</a> · Bookmark or copy the link to revisit these assumptions.</p>
    <noscript><p>JavaScript is needed to change assumptions. The default result above remains readable.</p></noscript>
  </div>
</section>

<CalculatorRuntime />
<style>
  #calc{scroll-margin-top:80px}
  .scenario-link{margin-top:20px;font-size:14px}
</style>
