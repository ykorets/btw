---
import { capacityLabel, equipmentLabel, dateLabel } from "../../lib/facts";
const { facilities, events } = Astro.props;
---
<section id="tracker"><div class="wrap">
  <div class="kicker">Documented fleet · limited coverage</div>
  <h2>The equipment behind the record</h2>
  <p class="sub">{facilities.length} published facilities. MW describe the equipment cohorts supported by the linked records. Permit ratings and historical observations do not establish current delivered power or complete site capacity.</p>
  <div style="overflow-x:auto;margin-top:22px"><table>
    <thead><tr><th>Facility</th><th>Documented MW</th><th>Equipment</th><th>Published permits</th><th>Latest record review</th><th>Sources</th></tr></thead>
    <tbody>{facilities.map((f: any) => {
      const review = events.find((e: any) => e.facility === f.slug && e.type === "record_reviewed");
      return <tr data-facility={f.slug}>
        <td><a href={`/facility/${f.slug}/`}><b>{f.name}</b></a><br/><span class="src">{f.county}, {f.state} · {f.developer}</span></td>
        <td class="mono"><span class="mw-live" data-slug={f.slug}>{capacityLabel(f)}</span></td>
        <td>{(f.unit || []).map((u: any) => <div>{equipmentLabel(u)}<br/><span class="src">{u.basis || "basis under review"} · {u.verification_state?.replaceAll("_", " ") || "verification pending"}</span></div>)}</td>
        <td>{(f.permit || []).map((p: any) => <div>{p.authority} {p.permit_no}<br/><span class="src">{p.status}</span></div>)}</td>
        <td class="src">{review ? <a href={`/facility/${f.slug}/#record-review`}>{dateLabel(review.date)}</a> : "No recent review published"}</td>
        <td class="src">{(f.sources || []).map((s: any) => <div><a href={s.archive_url || s.url} target="_blank" rel="noopener">{s.doc_genre?.replaceAll("_", " ") || "Source"} ↗</a></div>)}</td>
      </tr>;
    })}</tbody>
  </table></div>
  <div id="data" style="display:flex;gap:10px;flex-wrap:wrap;margin-top:20px;align-items:center">
    <a class="btn btn-primary" href="/data/">Open data portal</a><a class="btn" href="/api/v1/fleet.csv" download>Download CSV</a><a class="btn" href="/api/v1/facilities.json">JSON + sources</a><a class="btn" href="https://github.com/ykorets/btw/tree/mirror/data">All files</a><a class="btn" href="https://github.com/ykorets/btw">GitHub</a><span class="cite">Cite as: Behind the Watt, behindthewatt.com, CC BY 4.0</span>
  </div>
</div></section>
