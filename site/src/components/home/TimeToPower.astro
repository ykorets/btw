---
import { monthsToPower } from "../../lib/facts";
const { facilities } = Astro.props;
---
<section id="ttp"><div class="wrap"><div class="kicker">Time-to-power</div><h2>Dates need their own evidence</h2>
<p class="sub">A permit date, a campus opening and the first delivery from a particular power plant are different milestones. We publish an interval only when both endpoint fields carry receipts.</p>
<div id="ttp-live" style="margin-top:26px">{facilities.map((f: any) => {
 const months = monthsToPower(f);
 return <div class="ttp-row"><span><b>{f.name}</b> <span class="src">{f.state}</span></span><div class="ttp-track"><div class="ttp-zero"></div>{months != null && <div class="ttp-bar" style={`${months < 0 ? "right:60%" : "left:40%"};width:${Math.min(Math.abs(months) * 1.8, 38)}%;background:var(--green)`}></div>}</div><span class="ttp-val">{months == null ? "Dates under verification" : `${months < 0 ? "−" : ""}${Math.abs(months)} mo`}</span></div>;
})}</div><p class="src" style="margin-top:14px">Legacy dates remain available in the dataset for traceability. Missing endpoint receipts keep them out of this calculation.</p>
</div></section>
